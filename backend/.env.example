# --- App ---
APP_NAME="Noviq Intelligence"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
DATABASE_URL=postgresql+psycopg2://resumefraud:resumefraud@localhost:5432/resumefraud

# --- Auth ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage/resumes
MAX_UPLOAD_SIZE_MB=10

# Only needed if STORAGE_BACKEND=s3
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# --- NLP models ---
SPACY_MODEL=en_core_web_sm
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# --- Logging ---
LOG_LEVEL=INFO

# --- AI Rewrite Suggestions (Anthropic Claude) ---
# Leave ANTHROPIC_API_KEY blank to disable the feature gracefully (503, not a crash)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_OUTPUT_TOKENS=2000

# --- Education Verification ---
# Leave GHANA_EDU_API_KEY blank to skip the external lookup (falls back to
# "pending" for anything not in the local verified_schools table). The
# provider contract at GHANA_EDU_API_BASE_URL is UNVERIFIED — confirm the
# real request/response shape before enabling this in production.
GHANA_EDU_API_BASE_URL=https://api.ghana.dev/api/v1/education
GHANA_EDU_API_KEY=
GHANA_EDU_API_TIMEOUT_SECONDS=5.0
EDUCATION_VERIFY_RATE_LIMIT_PER_MINUTE=20
